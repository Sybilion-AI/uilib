MOBILE = 768px
DESKTOP = 1024px

pagePaddings()
  padding var(--page-y-padding) var(--page-x-padding)

pageXPadding()
  padding-left var(--page-x-padding)
  padding-right var(--page-x-padding)

pageYPadding()
  padding-top var(--page-y-padding)
  padding-bottom var(--page-y-padding)

line-clamp($lines)
  display -webkit-box
  -webkit-line-clamp $lines
  -webkit-box-orient vertical

focus-outline-style()
  outline var(--focus-outline-width, 2px) solid var(--focus-outline-color, var(--ring))
  outline-offset var(--focus-outline-offset, 2px)

focus-outline-target()
  &:not(:disabled):not([aria-disabled='true']):not([data-disabled])
    focus-outline-style()

focus-outline()
  &:focus-visible
    focus-outline-target()

focus-outline-within()
  &:focus-visible
  &:focus-within
    focus-outline-target()

:global(:root)
  @media (max-width: MOBILE)
    --page-x-padding: var(--p-6)
    --page-y-padding: var(--p-6)
