@import '../lib/theme.styl'

.root
  display flex
  flex-direction column
  height 100vh

.shell
  display grid
  flex 1
  min-height 0
  width 100%
  grid-template-columns 1fr
  grid-template-areas "main"

  @media (min-width MOBILE)
    grid-template-columns var(--sidebar-width) 1fr
    grid-template-areas "sidebar main"

  :global([data-slot="sidebar-wrapper"][data-state="collapsed"]) &
    @media (min-width MOBILE)
      grid-template-columns 0 1fr

.areaSidebar
  grid-area sidebar
  min-width 0

  @media (max-width MOBILE)
    display none

.areaMain
  grid-area main
  min-width 0
  background-color var(--page-color)
  border-radius var(--p-4)

.loading
  padding var(--p-8)
  color var(--muted-foreground)

.sidebarSearch
  z-index 10
  position sticky
  top 0 !important
  padding var(--p-3) 0 !important
  left var(--p-8)
  width calc(100% - var(--p-19)) !important
  box-shadow 0 8px 10px var(--background)

  input
    z-index 2
    border-radius var(--p-3) !important
    height var(--p-10) !important

  &::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    background-color var(--background)

.chevronContainer
  margin-left auto
  display flex
  align-items center
  flex-shrink 0

.subMenu
  position relative

  &::before
    content ''
    position absolute
    left var(--p-5)
    top 0
    bottom 26px
    width 1px
    background var(--sidebar-border)
    pointer-events none

.subMenuItem
  position relative
  margin-left var(--p-6)

  &::before
    content ''
    position absolute
    left calc(var(--p-1) * -1)
    top var(--p-2)
    bottom 0
    width var(--p-3)
    height var(--p-3)
    border-left 1px solid var(--sidebar-border)
    border-bottom 1px solid var(--sidebar-border)
    border-bottom-left-radius var(--p-2)
