@import '../lib/theme.styl'

.viewport
  position relative
  display flex
  flex-direction column
  height 100vh
  width 100%
  overflow hidden

.viewportWithBanner
  --app-banner-height: 44px
  --welcome-banner-height: 44px

.welcomeBannerOuter
  flex-shrink 0
  width 100%
  z-index 20

.pageScrollSlot
  flex 1
  min-height 0
  width 100%

  > *
    height 100%
    min-height 0

.root
  display flex
  flex-direction column
  height 100vh

.mainHeaderBar
  flex-shrink 0
  position sticky
  top 0
  z-index 10

.mainContent
  flex 1
  min-height 0
  min-width 0

.loading
  padding var(--p-8)
  color var(--muted-foreground)


.chevronContainer
  margin-left auto
  display flex
  align-items center
  flex-shrink 0
