@import '../lib/theme.styl'

.root
  display flex
  flex-direction column
  height 100vh

.mainHeaderBar
  flex-shrink 0
  position sticky
  top 0
  z-index 10

.mainContent
  flex 1
  min-height 0
  min-width 0

.loading
  padding var(--p-8)
  color var(--muted-foreground)


.chevronContainer
  margin-left auto
  display flex
  align-items center
  flex-shrink 0
