.root
  display block
  padding-top var(--p-1)
  padding-bottom var(--p-10)

.markdown
  display block
  max-width 720px
  line-height 1.6

  :global(.interactive-content)
    display block

  :global(h2)
    margin var(--p-4) 0 var(--p-2)
    font-size var(--text-base)
    font-weight 600
    color var(--foreground)

    &:first-child
      margin-top 0

  :global(ul)
    margin 0 0 var(--p-3)
    padding-left var(--p-5)

    li + li
      margin-top 2px

  :global(p)
    margin 0 0 var(--p-3)

    &:last-child
      margin-bottom 0
