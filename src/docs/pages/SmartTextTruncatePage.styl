.sectionLabel
  margin 0 0 var(--p-2)
  color var(--muted-foreground)
  font-size 0.875rem

.resizableListDemo
  resize horizontal
  overflow auto
  width 280px
  min-width 120px
  max-width 100%
  max-height 300px
  border 1px solid var(--border)
  border-radius var(--p-2)
  padding var(--p-2)

  &:active
    border 1px solid var(--brand-color)

.demoText
  display block
  width 100%
  margin-bottom var(--p-1)
