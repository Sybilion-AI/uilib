.scale
  display flex
  flex-direction column
  gap var(--p-2)

.row
  display flex
  align-items center
  gap var(--p-4)

.token
  font-family monospace
  font-size var(--text-xs)
  color var(--muted-foreground)
  min-width 64px
  user-select text

.bar
  height 20px
  background var(--brand-color-200)
  border-radius var(--radius-1)
  flex none

.value
  font-size var(--text-xs)
  color var(--muted-foreground)
  white-space nowrap

.sectionNote
  margin-bottom var(--p-3)
  color var(--muted-foreground)
