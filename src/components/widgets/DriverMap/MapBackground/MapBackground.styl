@import './mapAspect.mixin.styl'

// Map is <img src> from bundled URL (data URL or file). Avoids CSS url() resolving to broken relative paths in consumers.
.mapBackground
  position absolute
  display block
  width 100%
  height 100%
  mapAspect()
  object-fit contain
  object-position center
  pointer-events none
  user-select none
