@import '../../../lib/theme.styl'

.actionsAnchor
  display flex
  align-items center
  gap var(--p-2)
  flex-shrink 0

.pageActionsPortal
  display flex
  align-items center
  gap var(--p-1)
  flex-shrink 0

  &:empty
    display none

.logoArea
  position absolute
  top 22px
  left 28px
  z-index 10

  display flex
  align-items center
  gap var(--p-2)

  @media (max-width MOBILE)
    left 16px

  // Top-level shell + expanded sidebar: fixed logo when header scrolls; absolute when header is sticky.
  @media (min-width MOBILE)
    :global([data-slot='sidebar-wrapper'][data-state='expanded']:not([data-slot='app-shell'] [data-slot='sidebar-wrapper']) [data-slot='app-shell']:not([data-slot='app-shell'] [data-slot='app-shell'])) :global(header[data-sticky='false']) &:global(:not([data-slot='app-shell'] [data-slot='app-shell'] *))
      position fixed
      left 52px
      top calc(22px + var(--app-banner-height, 0px))

    :global([data-slot='sidebar-wrapper'][data-state='expanded']:not([data-slot='app-shell'] [data-slot='sidebar-wrapper']) [data-slot='app-shell']:not([data-slot='app-shell'] [data-slot='app-shell'])) :global(header[data-sticky='true']) &:global(:not([data-slot='app-shell'] [data-slot='app-shell'] *))
      position absolute
      left calc(-1 * var(--sidebar-width) + 40px)

    // Nested shell (e.g. docs embed): absolute within header; offset into sidebar when expanded.
    :global([data-slot='app-shell'] [data-slot='sidebar-wrapper'][data-state='expanded'] [data-slot='app-shell']) &
      position absolute
      left calc(-1 * var(--sidebar-width) + 44px)

    :global([data-slot='app-shell'] [data-slot='sidebar-wrapper'][data-state='collapsed'] [data-slot='app-shell']) &
      position absolute
      left var(--p-8)

.logoLink
  display flex
  align-items center
  gap 0.5rem
  width fit-content

  font-weight 400
  font-size 1.5rem
  color var(--foreground)
  text-decoration none
  white-space nowrap

  svg
    display inline-flex
    height 32px
    width auto
    flex-shrink 0
    transition transform 0.1s ease-in-out

  &:hover svg
    transform scale(1.05)

