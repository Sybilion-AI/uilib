@import '../../../lib/theme.styl'

.actionsAnchor
  display flex
  align-items center
  gap var(--p-4)
  flex-shrink 0

.pageActionsPortal
  display flex
  align-items center
  gap var(--p-4)
  flex-shrink 0

  &:empty
    display none

.logoArea
  position absolute
  top 22px
  left 40px
  z-index 10

  display flex
  align-items center
  gap var(--p-2)

  @media (max-width MOBILE)
    left 32px
  @media (min-width MOBILE)
    :global([data-slot='sidebar-wrapper'][data-state='expanded']) &
      position fixed

.logoAreaWithBanner
  top calc(22px + var(--welcome-banner-height, 0px))

  @media (min-width MOBILE)
    :global([data-slot='sidebar-wrapper'][data-state='collapsed']) &
      top 22px

.logoLink
  display flex
  align-items center
  gap 0.5rem
  width fit-content

  font-weight 400
  font-size 1.5rem
  color var(--color-foreground)
  text-decoration none
  white-space nowrap

  svg
    display inline-flex
    height 32px
    width auto
    flex-shrink 0
    transition transform 0.1s ease-in-out

  &:hover svg
    transform scale(1.05)

