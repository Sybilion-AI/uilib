@import '../../../../lib/theme.styl'

.root
  display flex
  align-items center
  justify-content flex-end
  gap var(--p-4)
  flex-grow 1

.horizonsLabel
  font-size 14px
  color var(--foreground)
  font-weight 500

.horizonsButtons
  display flex
  gap var(--p-2)

.horizonButton
  min-width 40px

.infoIcon
  margin-left 4px
  font-size 12px
  opacity 0.6
