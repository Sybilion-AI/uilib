.root
  display flex
  flex-direction column
  justify-content center
  align-items center
  width 100%
  padding 64px 48px
  position relative
  z-index 10
  height 100%
  font-family var(--font-family-heading)
  font-weight 300
  text-shadow 0 0 2px var(--background)

.headline
  font-size 40px
  line-height 48px
  text-align left
  width 100%
  max-width 480px

.headlineParagraph
  margin 0

.headlineCyan
  color #27d1ef
