.root
  height 100vh
  display flex
  width 100%

.leftPanel
  display none

  @media (min-width: 768px)
    display flex
    width 50%
    position relative
    overflow hidden
    background-color var(--secondary)
    border-top-left-radius var(--p-6)
    border-bottom-left-radius var(--p-6)
    border-top-right-radius var(--p-1)
    border-bottom-right-radius var(--p-1)

    :global(.dark) &
      background-color var(--page-color-alpha-800)

.bgImage
  position absolute
  bottom 0
  left 0
  width 300px
  height 300px
  background-size contain
  background-repeat no-repeat
  background-position left bottom

.logoContainer
  z-index 10
  position absolute
  top 0
  left 0
  display flex
  align-items center
  min-height 94px
  padding 16px 48px

.logo
  width 24px
  height 24px

.rightPanel
  flex 1
  background-color var(--background)
  display flex
  flex-direction column
  justify-content center
  align-items center
  padding 48px 64px

.formContainer
  // position relative
  max-width 480px
  width 100%

.header
  margin-bottom 36px

.title
  font-family var(--font-family-heading)
  font-weight normal
  font-size 30px
  line-height 42px
  margin 0
  margin-bottom 6px
  color var(--foreground)

.subtitle
  font-size 14px
  color var(--muted-foreground)
  line-height 16px
  margin 0
  font-family 'Manrope', sans-serif
  font-weight 500
