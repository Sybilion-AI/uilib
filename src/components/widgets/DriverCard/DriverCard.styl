@import '../../../lib/theme.styl';

.root
  width 100%
  height auto
  min-height 500px

  @media (min-width 640px)
    min-height 25rem

  @media (min-width 768px)
    min-height 31.25rem
    // width 20rem

.cardContent
  display flex
  flex-direction column
  gap 0.5rem

.noDriverSelected
  color var(--muted-foreground)

.driverHeader
  display flex
  flex-direction column
  align-items flex-start
  gap 0.75rem
  padding-bottom 0.25rem

.headerContent
  flex-grow 1
  display flex
  flex-direction column
  width 100%
  gap 0.5rem

.topHeader
  display flex
  align-items center
  justify-content space-between
  min-height 36px
  margin-top -12px

.categoryInfo
  font-size 0.75rem
  color var(--muted-foreground)
  display flex
  align-items center
  gap 0.25rem

.categoryIcon
  height 0.75rem
  width 0.75rem
  color var(--muted-foreground)

.categoryText
  line-clamp(1)
  overflow hidden
  text-transform lowercase
  &::first-letter
    text-transform uppercase

.driverTitle
  font-weight 500
  color var(--foreground)
  font-size 1.1rem
  line-height 1.4
  user-select text

  &.truncated
    line-clamp(2)
    overflow hidden
    cursor help

.regionDisplay
  font-size 0.75rem
  color var(--muted-foreground)

.metricsSection
  text-align left
  margin-bottom 0.5rem

.importanceScore
  font-size 2.25rem
  font-weight 400
  color var(--foreground)
  display flex
  align-items center
  line-height 1
  height auto
  user-select text

.directionLagSection
  display flex
  align-items center
  justify-content space-between

.directionBadge
  display flex
  align-items center
  gap 0.5rem

.trendIcon
  height 0.75rem
  width 0.75rem

.lagInfo
  font-size 0.75rem
  color var(--muted-foreground)

.description
  font-size 0.875rem
  line-height 1.625
  user-select text

.skeletonContainer
  display flex
  flex-direction column
  gap 1rem

.skeletonGroup
  display flex
  flex-direction column
  gap 0.5rem

.skeletonItem
  &.hxs
    height 0.75rem
  &.hs
    height 1rem
  &.hm
    height 2rem
  &.hl
    height 8rem

  &.w33
    width 33.333333%
  &.w50
    width 50%
  &.w75
    width 75%
  &.w80
    width 80%
  &.wFull
    width 100%

.tooltipContent
  max-width 20rem
  font-size 0.75rem

.tooltipTitle
  font-weight normal
  font-family var(--font-family-body)

.queueMessage
  display flex
  flex-direction column
  align-items center
  gap var(--p-4)
  padding var(--p-8) var(--p-4)
  color var(--muted-foreground)
  font-size 0.875rem
  line-height 1.5
  text-align center

  svg
    flex-shrink 0
    color var(--muted-foreground)
    opacity 0.8
