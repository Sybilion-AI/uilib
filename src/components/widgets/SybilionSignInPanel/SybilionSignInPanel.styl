.socialButtonContainer
  display flex
  width 100%
  gap 10px
  margin-bottom 10px

.socialButton
  flex 1
  height 48px
  padding 14px 16px
  font-size 14px
  font-weight 600
  border-radius 14px
  border 1px solid var(--border)

.errorMessage
  color red
  padding 10px
  font-size 14px
  margin-bottom 10px

.forgotPassword
  text-align right
  margin-bottom 24px

.forgotPasswordLink
  color var(--primary)
  text-decoration none
  font-size 14px
  font-family 'Manrope', sans-serif
  font-weight 500
  transition opacity 0.2s

  &:hover
    opacity 0.8

.version
  position absolute
  bottom 0
  right 0
  display block
  margin-top var(--p-8)
  padding-bottom var(--p-2)
  width 50%
  box-sizing border-box
  text-align center
  font-size 14px
  color var(--muted-foreground)
  opacity 0.5
  transition opacity 0.3s ease-out
  white-space nowrap
