.root
  // position fixed
  width 100%
  bottom 160px

.inlineRoot
  position relative
  width 100%
  margin-top var(--p-6)

.inner
  display flex
  flex-wrap wrap
  gap 8px
  padding var(--p-2) var(--p-6) var(--p-3)
  background-color var(--background)

.innerInline
  background-color transparent

.item
  flex-shrink 0
  min-width 0
  max-width 300px
  height auto
  min-height auto
  padding var(--p-3)
  text-align left
  font-size var(--text-xs)
  line-height 1.4
  white-space break-spaces !important
  overflow-wrap anywhere
