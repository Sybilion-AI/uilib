.root
  position relative
  flex-shrink 0
  width 100%

.inlineRoot
  position relative
  width 100%
  margin-top var(--p-6)

.inner
  display flex
  flex-wrap wrap
  gap 8px
  min-width 0
  padding var(--p-2) var(--p-6) var(--p-3)
  background-color var(--background)

.innerInline,
.innerClean
  background-color transparent

.item
  flex 0 1 auto
  min-width 0
  max-width unquote('min(300px, 100%)')
  height auto
  min-height auto
  padding var(--p-3)
  text-align left
  font-size var(--text-xs)
  line-height 1.4
  white-space break-spaces !important
  overflow-wrap anywhere
