@import 'lib/theme.styl';

INPUT_MAX_HEIGHT = 200px

.root
  position relative
  display flex
  flex-direction column
  gap var(--p-2)
  align-items stretch
  padding var(--p-6)
  padding-top var(--p-5)

.composer
  position relative
  display flex
  flex-direction row
  align-items flex-end
  gap var(--p-3)
  width 100%

.notice
  position absolute
  top calc(-1 * var(--p-12))
  left 0
  right 0
  margin-bottom var(--p-1)

  font-size var(--text-xs)
  text-align center
  color var(--muted-foreground)
  pointer-events none

  @media (max-width MOBILE)
    font-size 10px

.input
  flex 1
  min-width 0
  min-height 40px
  max-height INPUT_MAX_HEIGHT
  resize none
  overflow-y auto
  border none
  padding var(--p-2) 0 0 !important
  border-radius 0 !important
  box-shadow none !important

  &:focus
    box-shadow none !important

.submitColumn
  display flex
  flex-direction column
  flex-shrink 0
  align-items center
  justify-content flex-end

  & > button:focus
    box-shadow 0 0 0 2px var(--brand-color-500) !important

  & > button:first-child // submit button
    position relative
    border none

    transition all 0.2s

    &:focus
      transform scale(1.2)

    &::before
      content ''
      position absolute
      top -100%
      left -100%
      right -100%
      bottom -100%

  .attachButton
    background-color var(--page-color)
    box-shadow 0 0 20px var(--background)
