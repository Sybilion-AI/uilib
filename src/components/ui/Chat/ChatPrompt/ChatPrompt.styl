@import 'lib/theme.styl';

INPUT_MAX_HEIGHT = 200px

.root
  position relative
  display flex
  flex-direction column
  gap var(--p-2)
  align-items stretch
  padding var(--p-6)
  padding-top var(--p-5)

.composer
  position relative
  display flex
  flex-direction row
  align-items flex-end
  gap var(--p-3)
  width 100%

.fileInput
  display none

.attachButton
  flex-shrink 0
  align-self flex-end

.editorWrap
  flex 1
  min-width 0
  align-self stretch

.editorMount
  display flex
  flex 1
  flex-direction column
  min-width 0
  min-height 40px
  max-height INPUT_MAX_HEIGHT
  border none
  padding 0 !important
  border-radius 0 !important
  box-shadow none !important
  background transparent

  &:focus-within
    box-shadow none !important

  & :global(.ProseMirror)
    outline none !important
    border none !important
    flex 1
    padding var(--p-2) 0 0 !important
    margin 0
    white-space pre-wrap
    word-break break-word
    resize none !important
    box-shadow none !important
    min-height 40px !important
    max-height INPUT_MAX_HEIGHT !important
    overflow-y auto !important
    overflow-x hidden !important

  & :global(.ProseMirror p.is-empty.is-editor-empty::before)
    color var(--muted-foreground)
    content attr(data-placeholder)
    float left
    height 0
    pointer-events none

  & :global(.ProseMirror .slash-mention)
    display inline-flex
    align-items center
    padding 0 var(--p-1)
    border-radius var(--radius-sm)
    background var(--muted)
    font-size 0.875em
    line-height 1.4
    white-space nowrap
    user-select none
    vertical-align baseline

  & :global(.ProseMirror .chat-prompt-command-chip)
    display inline-flex
    align-items center
    padding 0 var(--p-1)
    border-radius var(--radius-sm)
    background var(--muted)
    color var(--foreground)
    font-size 0.875em
    line-height 1.4
    white-space nowrap
    user-select none
    vertical-align baseline

.submitColumn
  display flex
  flex-direction column
  flex-shrink 0
  align-items center
  justify-content flex-end

  & > button:focus
    box-shadow 0 0 0 2px var(--brand-color-500) !important

  & > button:first-child // submit button
    position relative
    border none

    transition all 0.2s

    &:focus
      transform scale(1.2)

    &::before
      content ''
      position absolute
      top -100%
      left -100%
      right -100%
      bottom -100%

.attachments
  display flex
  flex-wrap wrap
  gap var(--p-2)
  margin-bottom var(--p-2)

.attachmentItem
  flex 1 1 300px
  max-width 300px
  min-width 0
