@import 'lib/theme.styl';

.wrapper
  display flex
  align-items center
  gap var(--p-1)
  min-width 160px
  // z-index 1000

.selectGrow
  flex 1
  min-width 0

.selectTrigger
  // box-shadow 0 0 0 1px var(--border) !important
  width 100%

.deleteBtn
  flex-shrink 0
  border-radius 50px
  opacity 0
  pointer-events none

.wrapper:hover .deleteBtn
  opacity 1
  pointer-events auto

// Variant styles
.variantClear .selectTrigger
  border none
  background-color transparent
  box-shadow none

  &:hover
    box-shadow none
    background-color transparent

.variantDefault .selectTrigger
  background-color var(--background)

  &:hover
    box-shadow 0 0 0 2px var(--background)
