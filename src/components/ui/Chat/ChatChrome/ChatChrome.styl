@import 'lib/theme.styl'

.root
  position relative
  display flex
  flex-direction column
  height 100%
  min-height 0
  overflow hidden
  border-radius var(--p-4)

.chatResizeHandle
  position: absolute;
  // top 0 !important
  top -200px
  // height 100% !important
  height calc(100vh + 200px)
  left 0
  right auto
  // z-index 1000
  z-index 30

  width 5px
  border-radius 2.5px
  user-select none
  touch-action none
  transition opacity 150ms ease-out
  background-color var(--page-color)
  opacity 0

  &::before
    left 0
    right auto

.panelHeader
  position absolute
  display flex
  align-items center
  width 100%
  min-height 70px
  z-index 100

  flex-shrink 0
  display flex
  align-items center
  justify-content flex-end
  padding var(--p-2) var(--p-3)


.panelClose
  flex-shrink 0

.content
  flex 1
  min-height 0
  display flex
  flex-direction column
  position relative

.attachmentDropzone
  position absolute
  inset 0
  z-index 200

.scrollWrapper
  position relative
  flex 1
  min-height 0

.scroll
  z-index 3
  align-items flex-end
  position absolute
  height 100%
  width 100%
  max-height 100%
  max-width 100%
  padding-bottom var(--p-2)

.scrollbar
  right 0px !important

.scrollInner
  padding-top var(--p-10)
  min-height 100%

.emptyBody
  flex 1
  min-height 0
  display flex
  flex-direction column
  overflow hidden

  & > *
    flex 1
    min-height 0
    overflow auto

// ---------------

.footer
  position relative
  z-index 50
  display flex
  flex-direction column
  flex-shrink 0
  width 100%

  backdrop-filter blur(30px)
  background-color var(--background-alpha-800)
  border-top 1px solid var(--border)
  box-shadow 0 8px 24px 0 var(--background)

.fixedPresets
  position relative
  z-index 10
  flex-shrink 0
  width 100%

.notice
  position absolute
  top calc(-1 * var(--p-7))
  left 0
  right 0
  margin-bottom var(--p-1)

  font-size var(--text-xs)
  text-align center
  color var(--muted-foreground)
  pointer-events none

  @media (max-width MOBILE)
    font-size 10px

.loader
  // z-index 1
  // position absolute
  // top -150px
  margin var(--p-2) var(--p-6) var(--p-10)
  color var(--muted-foreground)

.branchRow
  display flex
  flex-wrap wrap
  gap 8px
  width 100%
  margin-top var(--p-6)
  padding 0 var(--p-6)

.branchBtnWrap
  display inline-flex
  vertical-align middle

