@import 'lib/theme.styl'

.panelRoot
  position relative
  display flex
  flex-direction column
  height 100%
  min-height 0
  overflow hidden

  &.variant-sidebar
    .footer
      backdrop-filter blur(30px)
      background-color var(--background-alpha-800)
      box-shadow 0 0 20px 16px var(--background)
      border-top 1px solid var(--border)

  &.variant-default
    .footer
      --chat-chrome-footer-variant default

.chatResizeHandle
  position: absolute;
  // top 0 !important
  top -200px
  // height 100% !important
  height calc(100vh + 200px)
  left 0
  right auto
  // z-index 1000
  z-index 30

  width 5px
  border-radius 2.5px
  user-select none
  touch-action none
  transition opacity 150ms ease-out
  background-color var(--page-color)
  opacity 0

  &::before
    left 0
    right auto

.panelHeader
  position absolute
  width 100%
  z-index 100

  flex-shrink 0
  display flex
  align-items center
  justify-content flex-end
  padding var(--p-2) var(--p-3)


.panelClose
  flex-shrink 0

.content
  flex 1
  min-height 0
  display flex
  flex-direction column
  position relative

.scrollWrapper
  position relative
  flex 1
  min-height 0

.scroll
  z-index 3
  align-items flex-end
  position absolute
  height 100%
  width 100%
  max-height 100%
  max-width 100%
  padding-bottom var(--p-2)

.scrollbar
  right 0px !important

.scrollInner
  padding-top var(--p-10)
  // padding-bottom 320px // goes under prompt

  &::after
    content ''
    display block
    height 220px
    background-color var(--background)


// ---------------

.footer
  z-index 50
  display flex
  flex-direction column

  position absolute
  bottom 0
  width 100%;


.loader
  // z-index 1
  // position absolute
  // top -150px
  margin var(--p-2) var(--p-6) var(--p-10)
  color var(--muted-foreground)

.branchRow
  display flex
  flex-wrap wrap
  gap 8px
  width 100%
  margin-top var(--p-6)
  padding 0 var(--p-6)

.branchBtnWrap
  display inline-flex
  vertical-align middle

