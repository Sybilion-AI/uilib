@import 'lib/theme.styl'

$sm = 640px

.breadcrumbList
  list-style none
  display flex
  flex-wrap wrap
  align-items center
  gap 0.375rem
  overflow-wrap break-word
  word-break break-word
  font-size 0.875rem
  line-height 1.25rem
  color var(--muted-foreground)

  @media (min-width: $sm)
    gap 0.625rem

.breadcrumbItem
  display inline-flex
  align-items center
  gap 0.375rem

.breadcrumbLink
  transition color 150ms ease

  &:hover
    color var(--foreground)

.breadcrumbPage
  font-weight 400
  color var(--foreground)

.breadcrumbSeparator
  display flex
  align-items center

  & > svg
    width 0.875rem
    height 0.875rem
    flex-shrink 0

.breadcrumbEllipsis
  display flex
  width 2.25rem
  height 2.25rem
  align-items center
  justify-content center
