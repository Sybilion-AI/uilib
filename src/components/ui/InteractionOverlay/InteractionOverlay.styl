.root
  position relative

.overlay
  position absolute
  inset 0
  z-index 4
  border none
  padding 0
  margin 0
  cursor pointer
  touch-action manipulation
  background transparent

  &::before
    content ''
    position absolute
    top calc(-1 * var(--p-2))
    right calc(-1 * var(--p-2))
    bottom calc(-1 * var(--p-2))
    left calc(-1 * var(--p-2))
    background-color unquote('color-mix(in srgb, var(--overlay-background-color) 70%, transparent)')
    box-shadow inset 0 0 80px 40px var(--overlay-background-color)
    pointer-events none
    z-index -1
    transition 200ms ease-out
    transition-property box-shadow, background-color

  .hidden &
    pointer-events none

    &::before
      box-shadow inset 0 0 0 0 var(--overlay-background-color)
      background-color transparent

.message
  position absolute
  top 50%
  left 50%
  transform translate(-50%, -50%)
  pointer-events none
  z-index 1
  font-size 0.875rem
  font-weight 500
  line-height 1.25
  color var(--foreground)
  white-space nowrap
  padding var(--p-3) var(--p-5)
  border-radius 9999px
  border 1px solid unquote('color-mix(in srgb, var(--foreground) 14%, transparent)')
  background-color unquote('color-mix(in srgb, var(--overlay-background-color) 80%, transparent)')
  backdrop-filter blur(10px)
  box-shadow \
    0 0 24px 10px var(--overlay-background-color), \
    0 0 0 1px unquote('color-mix(in srgb, var(--overlay-background-color) 40%, transparent)')
  transition 200ms ease-out
  transition-property transform, opacity

  .hidden &
    transform translate(-50%, -50%) scale(.3)
    opacity 0


:global(:root)
  --overlay-background-color var(--page-color)
