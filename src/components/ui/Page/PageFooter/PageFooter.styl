@import 'lib/theme.styl'

.root
  display flex
  flex-direction column
  gap 6px
  padding var(--p-5) var(--p-10)

.line
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap

  &:last-child
    min-height 55px

.copyright
  position relative
  display flex
  align-items center
  gap var(--p-4)
  font-size 14px

  svg
    color var(--brand-color-400)
    height 20px
    width 20px

.logo
  position relative
  display flex
  align-items center
  font-size var(--text-2xl)

  a
    display flex
    align-items center
    gap var(--p-2)
    text-decoration none
    color var(--foreground)

  svg
    height 24px
    width 24px

.version
  position absolute
  bottom 5px
  left calc(100% + 10px)

  display flex
  align-items center

  font-size 14px
  color var(--muted-foreground)
  opacity 0.5
  transition opacity 0.3s ease-out
  white-space nowrap

  &::before
    content 'v'

.versionLink
  color inherit
  text-decoration none

.logo:hover .version
  opacity 1
