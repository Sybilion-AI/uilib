@import 'lib/theme.styl'

.root
  display flex
  flex-direction column
  gap 6px
  padding var(--p-5) var(--p-10)

  @media (max-width: MOBILE)
    padding var(--p-10) var(--p-6)

.line
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap

  &:last-child
    min-height 55px

.meta
  display flex
  flex-wrap wrap
  align-items center
  gap var(--p-4)

.copyright
  font-size 14px

.links
  display flex
  flex-wrap wrap
  align-items center
  gap var(--p-4)

.link
  display inline-flex
  align-items center
  gap var(--p-2)
  font-size 14px
  color var(--foreground)
  text-decoration none

  &:hover
    text-decoration underline

  svg
    flex-shrink 0
    color var(--brand-color-400)
    height 20px
    width 20px

.logo
  position relative
  display flex
  align-items center
  font-size var(--text-2xl)

  a
    display flex
    align-items center
    gap var(--p-2)
    text-decoration none
    color var(--foreground)

  svg
    height 24px
    width 24px

.version
  position absolute
  bottom 10px
  left calc(100% + 10px)

  display flex
  align-items center

  font-size 14px
  color var(--muted-foreground)
  opacity 0.5
  white-space nowrap

  &::before
    content 'v'

  @media (min-width: unit(DESKTOP, 'px'))
    opacity 0
    transition opacity 0.1s ease-out

    .logo:hover &
      opacity 1

.versionLink
  color inherit
  text-decoration none

.logo:hover .version
  opacity 1
