@import 'lib/theme.styl'

SIDEBAR_SHEET_SPLIT = 1100px

.root
  display grid
  flex 1
  width 100%
  min-height 100%
  grid-template-columns 1fr
  grid-template-areas "main"

  @media (min-width SIDEBAR_SHEET_SPLIT)
    grid-template-columns var(--sidebar-width) 1fr
    grid-template-areas "sidebar main"

  :global([data-slot="sidebar-wrapper"][data-state="collapsed"]) &
    @media (min-width SIDEBAR_SHEET_SPLIT)
      grid-template-columns 0 1fr

.mainColumn
  grid-area main
  min-width 0
  display flex
  flex-direction column
  flex 1

  [data-slot="sidebar-wrapper"][data-state="collapsed"] &
    margin-left var(--p-3)

  @media (max-width MOBILE)
    margin-left var(--p-3) !important

.mainBody
  display flex
  flex-direction column
  flex 1
  min-width 0
  padding-bottom var(--page-y-padding)

  background-color var(--page-color)
  border-radius var(--p-4)
