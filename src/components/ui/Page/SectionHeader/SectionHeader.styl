.root
  display flex
  align-items center
  justify-content space-between
  width 100%

.withMargin
  margin var(--p-6) 0

.content
  display flex
  flex-direction column
  gap 6px
  flex 1 1 0
  min-width 0

.title
  font-family 'Manrope', sans-serif
  font-size 20px
  font-weight 500
  line-height 32px
  color var(--foreground, #001b1b)
  margin 0

.description
  font-family 'Manrope', sans-serif
  font-size 12px
  font-weight 400
  line-height 16px
  color var(--muted-foreground, #71717a)
  margin 0

.actions
  display flex
  align-items center
  flex-shrink 0
