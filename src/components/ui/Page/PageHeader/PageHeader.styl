@import 'lib/theme.styl'

.root
  position relative
  top 0
  z-index 50

  --transition-duration: 0.2s

  display flex
  align-items center

  width var(--page-width)
  max-width 100%
  pagePaddings()
  padding-bottom var(--p-7)

  border-top-left-radius 20px
  border-top-right-radius 20px
  overflow hidden

  // transition transform var(--transition-duration) ease-out

  @media (max-width: MOBILE)
    padding-bottom var(--p-5)

  // &::before
  // &::after
  //   transition transform var(--transition-duration) ease-out

  // &::before
  //   content ""
  //   position absolute
  //   left 0
  //   top 0
  //   width 100%
  //   height 100%
  //   background-color var(--page-color-alpha-800)
  //   backdrop-filter blur(30px)
  //   z-index -1

.inner
  display flex
  flex-direction column
  align-items flex-start
  justify-content center
  flex-wrap wrap
  flex-shrink 0
  align-items flex-start

  width 100%
  max-width 100%
  transition transform var(--transition-duration) ease-out

.main
  width 100%
  display flex
  justify-content space-between
  gap var(--p-4)
  margin-top var(--p-4)

.breadcrumbs
.title
  max-width 100%
  margin-right var(--p-2)

  .hasActions &
    max-width calc(100% - 200px)

    @media (max-width: MOBILE)
      max-width calc(100% - 130px)

.title
  flex-grow 1
  transition .5s opacity .1s ease-out

  h1
    width 100%
    margin 0

    opacity 1
    font-family var(--font-family-heading)
    font-weight 300
    font-size var(--text-2xl)
    line-height var(--text-2xl)
    color var(--foreground)

.subheader
  display block

  margin 0
  max-width 100%
  max-height 2.8em
  width 100%
  margin-top var(--p-1)

  overflow hidden
  word-break break-word
  line-clamp(2)
  user-select text

  color var(--muted-foreground)
  font-family 'Manrope', sans-serif
  font-size 0.75rem  // 12px
  font-weight 500
  line-height 1rem  // 16px

  &::selection
    color var(--foreground)


.actions
  display flex
  align-items flex-start
  flex-shrink 0
  transition transform .2s ease-out

  button
    position relative
    border 0
  & > * + *
    margin-left 0.5rem

.titleDupe
  display flex
  align-items center
  gap 0.5rem
  animation expandTitle .3s ease-out
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  max-height 22px

  svg
    flex-shrink 0

@media (max-width: unit(MOBILE, px))
  .root
  .inner
    transition none
  .main
    flex-direction column
  .title
    max-width 100% !important

// -----------------------------------
.scrolled
  padding-top 0
  padding-bottom 0
  flex-wrap nowrap
  flex-direction row
  justify-content flex-start
  align-items center

  transform translateY(-130px)

  &::before
    translateY(-130px)

  .inner
    transform translateY(106px)

  .breadcrumbs
    max-width 100%

  @media (max-width: MOBILE)
    transform translateY(-84px)
    .inner
      transform translateY(86px)

  .title
  .actions
    // width auto
    // font-size 20px
    opacity 0
    transition opacity .1s ease-out

  // .actions
    // transform translateY(-26px)

@keyframes expandTitle
  from
    opacity 0
  to
    opacity 1
