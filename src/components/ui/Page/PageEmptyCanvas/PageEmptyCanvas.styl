@import '../../../../lib/theme.styl'

.root
  display flex
  flex-direction column
  align-items center
  justify-content center
  flex-grow 1
  gap 12px

  min-height 280px
  max-width 28rem
  padding-bottom var(--p-20)
  margin 0 auto

  text-align center

.title
  margin 0
  font-size var(--text-lg)
  font-weight 600
  color var(--text-color)

.hint
  margin 0
  font-size var(--text-sm)
  color var(--muted-foreground)
  line-height 1.5
