.root
  width var(--page-width)
  max-width 100%
  gap var(--p-6)
  margin-bottom var(--p-10)

.scrollbar
  max-height 12px

.list
  max-width 100%

  &.withPaddings
    padding-left var(--page-x-padding)
    padding-right var(--page-x-padding)

.variant-button
.variant-outline
  .listInner
    gap var(--p-2)

.content
  position relative
  display flex
  flex-direction column
