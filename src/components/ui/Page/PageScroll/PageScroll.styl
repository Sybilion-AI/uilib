@import 'lib/theme.styl'

.root
  overflow hidden

  position relative
  display flex
  width 100%
  height 100vh
  flex-direction column

  @media (max-width MOBILE)
    height auto
    flex 1
    min-height 0

  // margin 0 10px 10px

  @media (min-width 768px)
    &[data-variant="inset"]
      margin-left 0

.inner
  width 100%
  min-height 100%
  max-height 100%
  padding-right var(--p-3)

.scrollbar
  & > div
  &::before
    right 14px !important
