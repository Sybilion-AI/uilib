@import 'lib/theme.styl'

.root
  display flex
  // flex-direction column
  gap var(--p-10)
  width 100%
  // margin 0 var(--page-x-padding)

.column
  position relative
  flex-shrink 1
  min-width 360px
  max-width 360px

@media (max-width: MOBILE)
  .root
    flex-direction column
  .column
    min-width 100%
    max-width 100%

.fill-left .column:first-child
.fill-right .column:last-child
.fill-all .column
  flex 1 1 0
  min-width 0
  max-width unset
