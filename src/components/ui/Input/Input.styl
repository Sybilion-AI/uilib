@import 'lib/theme.styl'

.root
  display flex
  width 100%
  min-width 0
  background-color transparent
  outline none
  overflow visible
  transition color, box-shadow, outline-color
  transition-duration 150ms
  focus-outline()

  &.variant-default,
  &.variant-clean
    padding-left 14px
    padding-right 14px

  &.variant-default
    padding-top 11px
    padding-bottom 11px
    border-radius var(--radius-input)
    box-shadow 0 0 0 1px var(--border)

    &[aria-invalid="true"]
      --focus-outline-color var(--destructive)
      box-shadow inset 0 0 0 2px var(--destructive)

    &:focus,
    &:focus-visible
      box-shadow none

  // Pill corners; after the variant rules so it overrides their radius
  &.round
    border-radius 100px

  &.size-sm
    height 32px
    font-size var(--text-xs)

  &.size-md
    height 40px
    font-size var(--text-sm)

  &.size-lg
    height 48px
    font-size var(--text-base)

  &:placeholder
    color var(--muted-foreground)

  &::selection
    background-color var(--primary)
    color var(--primary-foreground)

  &:disabled
    pointer-events none
    cursor not-allowed
    opacity 0.5

  &[type="file"]
    &::file-selector-button
      display inline-flex
      height 28px
      border 0
      background-color transparent
      font-size 14px
      font-weight 500
      color var(--foreground)

  // Dark mode styles
  :global(.dark) &
    background-color var(--input) / 0.3

    &.variant-default[aria-invalid="true"]
      box-shadow inset 0 0 0 2px var(--destructive)

    &.variant-default:focus,
    &.variant-default:focus-visible
      box-shadow none
