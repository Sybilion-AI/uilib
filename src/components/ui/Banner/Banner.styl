.root
  display flex
  align-items center
  flex-wrap wrap

  width fit-content
  padding var(--p-3) var(--p-4)
  margin-top calc(var(--p-4) * -1)
  margin-bottom var(--p-10)

  background-color var(--card)
  border-radius var(--p-2)

  a
    padding 0 var(--p-1)


.icon
  display inline-block
  margin-right var(--p-3)

.closeButton
  margin-left var(--p-1)
  opacity .5
  transition opacity 200ms ease

  &:hover
    opacity 1
