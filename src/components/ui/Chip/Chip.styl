@import 'lib/theme.styl'

.root
  display inline-flex
  align-items center
  width fit-content
  flex-shrink 0
  white-space nowrap
  border-radius var(--radius-pill)
  focus-outline()
  font-family var(--font-family-body)
  font-weight 400
  letter-spacing var(--tracking-body)
  transition background-color var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard)
  --status-positive var(--sb-green-700)
  --status-positive-bg var(--sb-green-50)
  --status-negative var(--sb-red-600)
  --status-negative-bg var(--sb-red-50)

  :global(.dark) &
    --status-positive var(--sb-green-400)
    --status-positive-bg var(--sb-green-900)
    --status-negative var(--sb-red-400)
    --status-negative-bg var(--sb-red-900)

  &.squared
    border-radius var(--p-1)

  &.sizeXs
    gap 4px
    min-height 28px
    padding 0 10px
    font-size var(--text-xs)
    line-height 1

    & > svg
    .arrow
      width 0.625rem
      height 0.625rem

    .dot
      width 4px
      height 4px

  &.sizeSm
    gap 6px
    padding var(--p-1) var(--p-2)
    font-size 11px
    line-height 1rem

    & > svg
      width 0.75rem
      height 0.75rem

    .arrow
      width 10px
      height 10px

  &.sizeMd
    gap var(--p-2)
    min-height 40px
    padding 11px 14px
    font-size var(--text-sm)
    line-height 1

    & > svg
    .arrow
      width 1rem
      height 1rem

    .dot
      width 8px
      height 8px

  &.sizeLg
    gap var(--p-2)
    min-height 48px
    padding var(--p-4) var(--p-6)
    font-size var(--text-base)
    line-height 1

    & > svg
    .arrow
      width 1.25rem
      height 1.25rem

    .dot
      width 8px
      height 8px

  & > svg
    pointer-events none

  &[role="combobox"]
    cursor pointer
    border none

  .dot
    width 6px
    height 6px
    border-radius 50%
    background var(--sb-cyan-400)
    flex none

  .arrow
    width 10px
    height 10px
    flex none
    pointer-events none

  // Neutral variant — slate wash with status dot
  &.variant-neutral
    background var(--sb-slate-100)
    color var(--sb-slate-800)

    :global(.dark) &
      background var(--sb-slate-800)
      color var(--sb-slate-200)

  // Line variant — hairline outline on surface
  &.variant-line
    background var(--background)
    border 1px solid var(--border)
    color var(--sb-slate-900)

    :global(.dark) &
      color var(--sb-slate-100)

  // Active variant — accent outline
  &.variant-active
    background transparent
    border 1px solid var(--sb-cyan-400)
    color var(--sb-slate-900)

    :global(.dark) &
      color var(--sb-slate-100)

  // Filled variant — inverse
  &.variant-filled
    background var(--sb-slate-900)
    color var(--sb-slate-50)

    :global(.dark) &
      background var(--sb-slate-100)
      color var(--sb-slate-900)

  // Accent variant — cyan wash
  &.variant-accent
    background var(--sb-cyan-100)
    color var(--sb-slate-900)

  // Status variants — quantitative delta / impact only
  &.variant-positive
    background var(--status-positive-bg)
    color var(--status-positive)

  &.variant-negative
    background var(--status-negative-bg)
    color var(--status-negative)

  // Yellow variant — caution / pending status
  &.variant-yellow
    background-color var(--sb-yellow-50)
    color var(--sb-yellow-600)

    :global(.dark) &
      background-color var(--sb-yellow-900)
      color var(--sb-yellow-400)
