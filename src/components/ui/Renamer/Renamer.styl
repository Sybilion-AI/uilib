
  display inline-block
  max-width 100%
  vertical-align top

  &:has(.input)
    display block
    width 100%

.value
  display inline

// Matches PageHeader .title h1 typography (page title context).
.size-lg.root
  .value
    font-family var(--font-family-heading)
    font-weight 300
    font-size var(--text-2xl)
    line-height var(--text-2xl)
    color var(--foreground)

  .input
    font-family var(--font-family-heading)
    font-weight 300
    font-size var(--text-2xl)
    line-height var(--text-2xl)
    color var(--foreground)
    height auto
    min-height var(--text-2xl)
    padding 4px 12px 4px 0
    border-radius var(--p-4)
    box-shadow 0 0 0 1px var(--border)

.empty.size-lg.root .input
  background-color var(--accent) / 0.1

.button
  position relative
  display inline-flex
  vertical-align middle

  height fit-content !important
  width fit-content !important
  margin-left var(--p-2)

  opacity 0.5
  transition opacity 0.2s ease-out

  // minimal clickable area
  &::before
    content ''
    position absolute
    left -18px
    top -18px
    display block
    width 50px
    height 50px

  .root:hover &
    opacity 1

// Pencil icon tracks Button `size` via --icon-size-* tokens (sm 14 / md 16 / lg 20px).
.size-sm .button svg
  width var(--icon-size-sm)
  height var(--icon-size-sm)

.size-md .button svg
  width var(--icon-size-md)
  height var(--icon-size-md)

.size-lg .button svg
  width var(--icon-size-lg)
  height var(--icon-size-lg)
