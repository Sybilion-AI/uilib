@import 'lib/theme.styl'

$sm = 640px
$md = 768px

.overlay
  position fixed
  inset 0
  z-index 1100
  background-color rgba(0, 0, 0, 0.5)
  backface-visibility hidden

  &[data-state="open"]
    animation drawerFadeIn 150ms ease-out

  &[data-state="closed"]
    animation drawerFadeOut 150ms ease-in

.content
  position fixed
  z-index 1100
  display flex
  flex-direction column
  height auto
  background var(--background)

  &[data-vaul-drawer-direction="top"]
    left 0
    right 0
    top 0
    margin-bottom 6rem
    max-height 80vh
    border-bottom 1px solid var(--border)
    border-radius 0 0 0.5rem 0.5rem

  &[data-vaul-drawer-direction="bottom"]
    left 0
    right 0
    bottom 0
    margin-top 6rem
    max-height 80vh
    border-top 1px solid var(--border)
    border-radius 0.5rem 0.5rem 0 0

  &[data-vaul-drawer-direction="right"]
    top 0
    right 0
    bottom 0
    width 75%
    border-left 1px solid var(--border)

    @media (min-width: $sm)
      max-width 24rem

  &[data-vaul-drawer-direction="left"]
    top 0
    left 0
    bottom 0
    width 75%
    border-right 1px solid var(--border)

    @media (min-width: $sm)
      max-width 24rem

.handle
  margin-left auto
  margin-right auto
  margin-top var(--p-4)
  display none
  height 0.5rem
  width 100px
  flex-shrink 0
  border-radius 9999px
  background var(--muted)

.content[data-vaul-drawer-direction="bottom"] .handle
  display block

.header
  display flex
  flex-direction column
  gap 0.125rem
  padding var(--p-4)

  @media (min-width: $md)
    gap 0.375rem

.content[data-vaul-drawer-direction="left"] .header,
.content[data-vaul-drawer-direction="right"] .header
  @media (min-width: $md)
    text-align left

.content[data-vaul-drawer-direction="bottom"] .header,
.content[data-vaul-drawer-direction="top"] .header
  text-align center

.footer
  margin-top auto
  display flex
  flex-direction column
  gap var(--p-2)
  padding var(--p-4)

.title
  font-weight 600
  color var(--foreground)

.description
  font-size 0.875rem
  line-height 1.25rem
  color var(--muted-foreground)

@keyframes drawerFadeIn
  from
    opacity 0
  to
    opacity 1

@keyframes drawerFadeOut
  from
    opacity 1
  to
    opacity 0
