// Chart container
.chartContainer
  display flex
  aspect-ratio 16 / 9
  justify-content center
  max-width 100%
  width 100%
  font-size 0.75rem /* text-xs */
  line-height 1rem
  touch-action none

  :global
    .recharts-cartesian-axis-tick text
      fill var(--muted-foreground)

    .recharts-cartesian-grid line[stroke='#ccc']
      stroke var(--border)

      :global(.dark) &
        stroke  var(--sb-slate-900)

    .recharts-curve.recharts-tooltip-cursor
      stroke var(--border) // / 0.5

    .recharts-polar-grid [stroke='#ccc']
      stroke var(--border)

    .recharts-radial-bar-background-sector
      fill var(--muted)

    .recharts-rectangle.recharts-tooltip-cursor
      fill var(--muted)

    .recharts-reference-line [stroke='#ccc']
      stroke var(--border)

    .recharts-dot[stroke='#fff']
      stroke transparent

    .recharts-layer
      outline none

    .recharts-sector
      outline none

      &[stroke='#fff']
        stroke transparent

    .recharts-surface
      outline none

    // Layer ordering: grid (1), pin overlay (2), lines/dots/tooltip (3+)
    .recharts-wrapper
      position relative

    .recharts-surface
      position relative
      z-index 1

    // Tooltip portal positions with absolute + transform; do not override with relative.
    .recharts-tooltip-wrapper
      z-index 3 !important

    // Active dots and cursor
    .recharts-active-dot
      z-index 3

// Chart grid styles
.chartGrid
  // stroke-dasharray 3 6
  stroke-width 0.6


// Tooltip styles
.tooltipContainer
  display grid
  box-sizing border-box
  width max-content
  max-width 100%
  min-width 0
  overflow-wrap break-word
  word-break break-word
  align-items start
  gap 0.375rem /* gap-1.5 */
  padding 0.375rem 0.625rem /* py-1.5 px-2.5 */
  border-radius 0.5rem /* rounded-lg */
  border 1px solid var(--border) / 0.5
  background-color var(--background)
  font-size 0.75rem /* text-xs */
  line-height 1rem
  box-shadow 0 10px 10px -5px rgba(0 0 0 0.3), 0 0 2px 0 rgba(0 0 0 0.5) /* shadow-xl */
  opacity 0
  transition opacity 0.5s ease-out

  .chartContainer:hover &
    opacity 1
    transition-duration 0.5s

.tooltipItem
  display flex
  width 100%
  flex-wrap wrap
  align-items stretch
  gap 0.5rem /* gap-2 */

  & > svg
    height 0.625rem /* h-2.5 */
    width 0.625rem /* w-2.5 */
    color var(--muted-foreground)

.tooltipIndicator
  flex-shrink 0
  border-radius 2px
  border-width 1px
  border-color var(--color-border)
  background-color var(--color-bg)

  &.indicator-dot
    height 0.625rem /* h-2.5 */
    width 0.625rem /* w-2.5 */

  &.indicator-line
    width 0.25rem /* w-1 */

  &.indicator-dashed
    width 0
    border-width 1.5px
    border-style dashed
    background-color transparent

    &.nested
      margin-top 0.125rem /* my-0.5 */
      margin-bottom 0.125rem

.tooltipContent
  display flex
  flex 1 1 0%
  justify-content space-between
  line-height 1

.tooltipLabel
  display grid
  gap 0.375rem /* gap-1.5 */

.tooltipValue
  font-family ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace
  font-weight 500
  font-variant-numeric tabular-nums
  color var(--foreground)
  margin-left var(--p-3)

// Legend styles
.legendContainer
  display flex
  align-items center
  justify-content center
  gap 1rem /* gap-4 */

.legendItem
  display flex
  align-items center
  gap 0.375rem /* gap-1.5 */

  & > svg
    height 0.75rem /* h-3 */
    width 0.75rem /* w-3 */
    color var(--muted-foreground)

.legendIndicator
  height 0.5rem /* h-2 */
  width 0.5rem /* w-2 */
  flex-shrink 0
  border-radius 2px

// Blinking animation for loading chart lines
@keyframes chart-line-blink
  from
    opacity 0.5
  to
    opacity 1

:global
  .chart-line-blinking
    path
      animation chart-line-blink 1s ease-in-out infinite
      animation-direction alternate

