.root
  flex-wrap wrap
  row-gap 0.5rem
  margin-top 0.75rem

.button
  appearance none
  background none
  border 0
  padding 0
  font inherit
  color inherit
  cursor pointer

.dimmed
  opacity 0.4

// A short line in the series' colour (currentColor), dashed for a forecast.
.swatch
  width 14px
  height 0
  flex-shrink 0
  border-top 2px solid currentColor

.dashed
  border-top-style dashed

// A bar's or an area's swatch.
.square
  width 0.5rem
  height 0.5rem
  border-top 0
  border-radius 2px
  background currentColor
