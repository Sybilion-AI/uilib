.legendContainer
  display flex
  align-items center
  justify-content flex-start
  gap var(--p-4)
  flex-wrap wrap

.legendItem
  display flex
  align-items center
  gap var(--p-2)
  cursor pointer
  user-select none
  transition opacity 0.2s ease

  &:hover
  &.disabled
    opacity 0.5

  &.disabled:hover
    opacity 0.8

.legendLineIcon
  display flex
  align-items center
  gap 2px
  flex-shrink 0
  height 12px

.line
  --line-size: 1.5px;
  display flex
  align-items center
  width 16px
  height var(--line-size)

  &.dashed
    border-top var(--line-size) dashed
    height 0

.dot
  width 6px
  height 6px
  transform rotate(45deg)
  flex-shrink 0

.forecastIcon
  width 16px
  height 16px
  flex-shrink 0
  position relative
  display flex
  align-items center
  justify-content center

.forecastArrow
  width 100%
  height 100%
  position relative

  // Arrow shaft (diagonal line going up)
  &::before
    content ''
    position absolute
    left 2px
    bottom 3px
    width 10px
    height 2px
    background currentColor
    transform rotate(-45deg)
    transform-origin left bottom
    opacity 0.7

  // Arrow head (right part)
  &::after
    content ''
    position absolute
    right 2px
    top 2px
    width 5px
    height 5px
    border-right 2px solid currentColor
    border-top 2px solid currentColor
    opacity 0.7

.legendLabel
  font-size var(--text-xs)
  line-height var(--line-height-base)
  color var(--foreground)
  white-space nowrap

.selectTrigger
  min-width auto
  height auto
  padding var(--p-1) var(--p-2)
  font-size var(--text-xs)

.selectItemContent
  display flex
  align-items center
  gap var(--p-2)

