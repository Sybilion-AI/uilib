.root
  position absolute
  inset 0
  pointer-events none
  z-index 15

.dot
  position absolute
  width var(--p-3)
  height var(--p-3)
  border-radius 50%
  background-color red
  border 3px solid var(--dot-border-color)
  transform translate(-50%, -50%)
  box-shadow 0px 2px 4px rgba(0, 0, 0, 0.2)
  pointer-events none
