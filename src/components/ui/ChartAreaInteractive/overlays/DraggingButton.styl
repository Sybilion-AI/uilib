.draggingButton
  width: 36px
  height: 36px
  background: var(--background, #ffffff)
  border: 1px solid var(--input, #e4e4e7)
  border-radius: 9999px
  display: flex
  align-items: center
  justify-content: center
  cursor: grab
  z-index: 10
  pointer-events: auto
  transition: all 0.2s

  &:hover
    border-color: var(--foreground, #001b1b)
    background: var(--accent, #f4f4f5)

  &:active
    cursor: grabbing

  svg
    width: 16px
    height: 16px
    color: var(--foreground, #001b1b)

.dragging
  cursor: grabbing

