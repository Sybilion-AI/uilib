.selection
  position absolute
  top 0
  bottom 0
  background-color var(--brand-color-500)
  opacity 0.1
  border 1px solid var(--ring)
  pointer-events none
  box-sizing border-box

.host
  position relative
  width 100%
  overflow visible
  touch-action pan-y

.plotBox
  position absolute
  z-index 8
  pointer-events none
  box-sizing border-box
