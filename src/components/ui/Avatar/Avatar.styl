.root
  position relative
  display flex
  align-items center
  justify-content center
  overflow hidden
  border-radius 100%

  &.size-sm
    width 24px
    height 24px
  &.size-md
    width 32px
    height 32px
  &.size-lg
    width 48px
    height 48px

.image
  aspect-ratio 1/1
  width 100%
  height 100%
  object-fit cover

.fallback
  display flex
  align-items center
  justify-content center
  width 100%
  height 100%
  background-color var(--muted)
