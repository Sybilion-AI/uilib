// Base button styles
.root
  display inline-flex
  align-items center
  justify-content center
  gap 10px
  flex-shrink 0
  white-space nowrap
  border-radius var(--radius-button)
  font-family 'Manrope', sans-serif
  font-size 15px
  font-weight 500
  line-height 1
  outline none
  cursor pointer
  transition all var(--dur-base) var(--ease-standard)
  border 0

  &:active
    opacity 0.8

  &:disabled
    pointer-events none
    opacity 0.5

  &:focus-visible
    border-color var(--ring)
    ring 3px var(--ring-50)

  &[aria-invalid="true"]
    border-color var(--destructive)
    ring 3px var(--destructive-200)

  // SVG icon styles
  svg
    pointer-events none
    flex-shrink 0
    // width 16px
    // height 16px

// Variant styles
.default
  background-color var(--primary)
  color var(--primary-foreground)

  &:hover
    background-color var(--sb-gray-800)

    :global(.dark) &
      background-color var(--sb-gray-600)

.destructive
  background-color var(--destructive-900)
  color white

  &:hover
    background-color var(--destructive-600)

  &:focus-visible
    ring 3px var(--destructive-200)

    :global(.dark) &
      ring 3px var(--destructive-400)

.outline
  border 1px solid var(--border)
  background-color var(--background)

  &:hover
    background-color var(--sb-gray-50)
    border-color var(--border)

  :global(.dark) &
    background-color var(--sb-gray-900)
    border-color var(--border)

    &:hover
      background-color var(--sb-gray-800)

.secondary
  background-color var(--secondary)
  color var(--secondary-foreground)

  &:hover
    background-color var(--secondary-800)

.ghost
  &:hover
    background-color var(--sb-gray-100)
    color var(--foreground)

    :global(.dark) &
      background-color var(--sb-gray-900)

.link
  color var(--primary)
  text-decoration underline
  text-underline-offset 4px

  &:hover
    text-decoration underline

// Size styles

.sizeSm
  height 30px
  padding 0 14px
  font-size 13px
  border-radius var(--p-5)

.sizeMd
  height 44px
  padding 0 var(--p-4)
  border-radius var(--p-4)

.sizeLg
  height 48px
  padding 0 var(--p-6)
  font-size var(--text-base)
  border-radius var(--p-4)

// Icon buttons: square, sized per size variant, same radius as the size variant
.sizeIcon
  padding 0
  width 48px
  height 48px

  &.sizeSm
    width 36px
    height 36px
    padding 0

  &.sizeMd
    width 48px
    height 48px
    padding 0

  &.sizeLg
    width 56px
    height 56px
    padding 0
