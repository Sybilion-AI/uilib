@import '../../../lib/theme.styl'

.root
  display flex
  align-items center
  width 100%
  min-height var(--header-height)
  padding-left 200px
  background-color var(--color-background)

  &.sidebarOpen
    padding-left var(--sidebar-width)

.content
  display flex
  align-items center
  justify-content flex-end
  width 100%
  padding 0 var(--p-9)
  gap 2rem

.logo
  display flex
  align-items center
  gap 0.5rem

  font-weight 400
  font-size 1.5rem
  color var(--color-foreground)
  text-decoration none
  white-space nowrap

  svg
    display inline-flex
    height 32px
    width auto
    transition transform 0.1s ease-in-out

  &:hover svg
    transform scale(1.05)

.nav
  display flex
  align-items center
  justify-content center
  gap 1.5rem
  flex 1

  @media (max-width: units(MOBILE, 'px'))
    display none

.navLink
  font-size 0.875rem
  font-weight 400
  color var(--color-muted-foreground)
  text-decoration none
  transition color 0.2s ease

  &:hover
    color var(--color-foreground)

.actions
  display flex
  align-items center
  gap var(--p-4)
  margin-right var(--p-2)

  @media (max-width: units(MOBILE, 'px'))
    gap var(--p-1)

.pageHeaderActionsAnchor
  display flex
  align-items center
  gap var(--p-4)
  flex-shrink 0
