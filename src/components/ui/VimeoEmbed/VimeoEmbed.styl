.root
  position relative
  height auto !important
  height 0
  min-width 0
  margin 0
  padding-bottom 0

  aspect-ratio 16 / 9.5
  overflow hidden
  border-radius var(--p-5)

  flex-shrink 0
  align-self stretch
  box-shadow 0 0 0 1px var(--border)

.iframe
  z-index 1
  position absolute
  top 0
  left 0
  width 100%

  display block
  height 100%
  margin 0
  padding 0
  border none
  border-radius var(--p-5)
  opacity .5
  transition opacity 0.5s ease

  transform scale(1.01) // fix rounded border cut off issue

  .isPlaying &
    opacity 1

.playButton
  position absolute
  width 100%
  height 100%
  background var(--background-alpha-500)
  border none
  cursor pointer
  z-index 3
  display flex
  align-items center
  justify-content center
  transition all 0.2s ease
  box-shadow 0 2px 16px var(--page-color)

  &:hover
    background transparent

  .isPlaying &
    opacity 0
    pointer-events none

.playIcon
  width var(--p-16)
  height var(--p-16)
  color var(--brand-color-400)
  margin-left 4px // Slight offset for visual centering
