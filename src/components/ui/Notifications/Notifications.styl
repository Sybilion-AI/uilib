@import 'lib/theme.styl'

.root
  position fixed
  top var(--header-height)
  right 0
  z-index 100
  width 320px
  max-height calc(var(--vh, 1vh) * 100 - var(--header-height))
  overflow hidden
  transform translateZ(0)
  transition right 0.3s ease-out

  &.empty
    pointer-events none

.scrollbar
  right 6px !important
  width 10px !important

.inner
  padding var(--p-5)
  padding-right var(--p-3)

.item
  position relative
  width 300px
  max-width 100%
  max-height 0
  opacity 0
  left 100%
  backface-visibility hidden
  transition all 0.3s ease-out

  &:first-child
    margin-top calc(var(--p-2) * -1)

  & + &
    padding-top var(--p-2)

  &:hover
    transform translateX(-2px)

  &.visible
    left 0
    max-height 500px
    opacity 1

.itemInner
  display flex
  align-items flex-start
  gap var(--p-3)
  box-sizing border-box
  position relative
  padding var(--p-3)
  padding-right var(--p-6)
  border-radius var(--p-3)
  background-color var(--card)
  box-shadow 0 0 0 1px var(--border)
  backdrop-filter blur(30px)

.type-warning .itemInner
  background-color var(--warning-color-alpha-300)

.type-danger .itemInner
  background-color var(--danger-color-alpha-300)

.type-loading .itemInner,
.type-default .itemInner
  background-color var(--decent-color-alpha-500)

.icon
  flex-shrink 0
  margin-top 2px
  color var(--foreground)

  &.spin
    animation notification-spin 1s linear infinite

.text
  display flex
  flex-direction column
  flex-grow 1
  min-width 0
  z-index 1

.title
  font-size var(--text-base)
  font-family var(--font-family-heading)
  font-weight 600
  line-height 1.3

.content
  font-size var(--text-sm)
  // color var(--muted-foreground)
  line-height 1.2

  &:first-child
    margin-top 0

.closeButton
  position absolute
  top -4px
  right -6px
  opacity 0
  transform scale(0.85)
  transition opacity 0.15s ease-out, transform 0.15s ease-out
  focus-outline()

.closeButton:focus-visible
  opacity 0.85
  transform scale(1)

.item:hover .closeButton
  opacity 0.85
.closeButton:hover
  opacity 1 !important

.closeButton:hover
  opacity 1
  transform scale(1)

@keyframes notification-spin
  from
    transform rotate(0deg)
  to
    transform rotate(360deg)

@media (max-width: 700px)
  .root,
  .item
    width 100%

  .title
    font-size var(--text-lg)

  .content
    font-size var(--text-base)

  .closeButton
    opacity 0.85
    transform scale(1)
