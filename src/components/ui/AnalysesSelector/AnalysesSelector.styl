.root
  display flex
  align-items center
  justify-content flex-start
  flex-wrap wrap
  // margin-left calc(var(--p-2) * -1)

.selectTriggerRenamer
  min-width 0

.selectInlineRenamer
  display flex
  align-items center
  min-width 0

.selectInlineRenamerInput
  padding 0 var(--p-2)
  margin-left calc(var(--p-2) * -1)
  max-width calc(100% - var(--p-4)) !important
  border-radius var(--p-2)

.renamerEditButton
  opacity 0.5
  flex-shrink 0
  transition opacity 0.2s ease-out

  .selectInlineRenamer:hover &
    opacity 1

.variant-default.single
  background-color var(--background)
  border-radius var(--p-4)
  padding 0 var(--p-2)

.item
  display flex
  align-items center
  gap var(--p-2)
  margin var(--p-1)

  cursor pointer
  user-select none
  transition opacity 0.2s ease

  &:hover
  &.disabled
    opacity 0.5

  &.disabled:hover
    opacity 0.8

  &.historical
    pointer-events none

  &.dimmed
    opacity 0.5

.itemBadge
  margin-top -2px
  margin-bottom -2px

.icon
  width 16px
  height 16px
  max-width 16px
  max-height 16px
  flex-shrink 0
  overflow hidden

.iconImage
  display block
  object-fit contain

.iconWrapper
  position relative
  display flex
  align-items center
  justify-content center

  > img
    width 100%
    height 100%
    max-width 100%
    max-height 100%
    object-fit contain

// Restore icon sizing in portal dropdown (large source assets e.g. Expert.png)
:global([data-slot="select-item"] [data-slot="analysis-icon"])
  width 16px !important
  height 16px !important
  max-width 16px !important
  max-height 16px !important
  flex-shrink 0
  overflow hidden
  object-fit contain

.label
  flex 1 1 auto
  min-width 0
  font-size var(--text-xs)
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.selectItemContent
  display flex
  flex-direction row
  flex-wrap nowrap
  align-items center
  gap var(--p-2)
  width 100%
  min-width 0
  flex 1

.selectTrigger
  min-width auto
  height auto
  font-size var(--text-xs)

.selectTriggerRenaming
  width 100% !important
  max-width 100% !important

  .selectTriggerContent
    flex 1
    width 100%
    min-width 0

  .selectTriggerRenamer
    min-width 0

.selectTriggerLabelWithId
  display flex

.selectTriggerContent
  display flex
  align-items center
  gap var(--p-2)
  min-width 0
  min-height var(--p-9)

  > :last-child
    flex-shrink 0
    min-width 0
    max-width 100%

.selectTriggerRenamerDisabled
  button
    pointer-events none

.itemLabelWithId
  flex-grow 1
  min-width 0
  display flex
  align-items center
