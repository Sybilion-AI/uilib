.lineIcon
  display flex
  align-items center
  gap 2px
  flex-shrink 0
  height 12px

.line
  display flex
  align-items center
  flex-shrink 0
  width 18px
  height 1.5px
  max-height @height
  border-radius var(--p-1)

.dot
  width 6px
  height 6px
  transform rotate(45deg)
  flex-shrink 0
  margin-left -2px
