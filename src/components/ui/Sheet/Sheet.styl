@import 'lib/theme.styl'

$animationDuration = 200ms

.overlay
  position fixed
  inset 0
  z-index 50
  background-color rgba(0, 0, 0, 0.5)
  backface-visibility hidden

  &[data-state="open"]
    animation fadeIn 150ms ease-out

  &[data-state="closed"]
    animation fadeOut 150ms ease-in

.content
  position fixed
  z-index 50
  display flex
  flex-direction column
  // gap var(--p-4)
  background var(--background)
  box-shadow 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)
  transition all ease-in-out

  &[data-state="open"]
    animation-duration $animationDuration

  &[data-state="closed"]
    animation-duration $animationDuration

  // Right side variant
  &.sideRight
    top 0
    right 0
    bottom 0
    height 100%
    width 75%
    border-left 1px solid var(--border)

    &[data-state="open"]
      animation slideInFromRight $animationDuration ease-out

    &[data-state="closed"]
      animation slideOutToRight $animationDuration ease-in

    @media (min-width: 640px)
      width 500px

  // Left side variant
  &.sideLeft
    top 0
    left 0
    bottom 0
    height 100%
    width 75%
    border-right 1px solid var(--border)

    &[data-state="open"]
      animation slideInFromLeft $animationDuration ease-out

    &[data-state="closed"]
      animation slideOutToLeft $animationDuration ease-in

    @media (min-width: 640px)
      width 500px

  // Top side variant
  &.sideTop
    top 0
    left 0
    right 0
    height auto
    border-bottom 1px solid var(--border)

    &[data-state="open"]
      animation slideInFromTop $animationDuration ease-out

    &[data-state="closed"]
      animation slideOutToTop $animationDuration ease-in

  // Bottom side variant
  &.sideBottom
    bottom 0
    left 0
    right 0
    height auto
    border-top 1px solid var(--border)

    &[data-state="open"]
      animation slideInFromBottom $animationDuration ease-out

    &[data-state="closed"]
      animation slideOutToBottom $animationDuration ease-in

  // Full width variant
  &.fullWidth
    width 100vw
    max-width 100vw

.close
  position absolute
  top 0
  right 0

  display flex
  align-items center
  justify-content center

  height 50px
  width 50px

  border-radius var(--radius-sm)
  outline none
  cursor pointer

  &:focus
    ring 2px
    ring-color var(--ring)
    ring-offset 2px
    ring-offset-color var(--background)

  &:disabled
    pointer-events none

  &[data-state="open"]
    background var(--secondary)

  &::before
    content ''
    position absolute
    --gap: var(--p-2)
    top var(--gap)
    right var(--gap)
    width calc(100% - (var(--gap) * 2))
    height calc(100% - (var(--gap) * 2))
    background-color var(--background)
    // backdrop-filter blur(10px)
    border-radius 50%
    transition scale 0.2s ease

  @media (max-width: unit(MOBILE, 'px'))
    transform scale(1.4) translate(-6px, 6px)

  & > svg
    opacity .3
    transition opacity 0.2s ease
    z-index 1
  &:hover > svg
    opacity 1
    scale 1.3
  &:hover::before
    scale 2

.header
  display flex
  flex-direction column
  gap var(--p-2)
  padding var(--p-8) var(--p-6)
  font-family var(--font-family-heading)

.footer
  margin-top auto
  display flex
  flex-direction column
  gap var(--p-2)
  padding var(--p-4)

.title
  font-weight 300
  font-size var(--text-2xl)

.description
  color var(--muted-foreground)
  font-size 0.875rem


@keyframes fadeIn
  from
    opacity 0
  to
    opacity 1

@keyframes fadeOut
  from
    opacity 1
  to
    opacity 0

@keyframes slideInFromRight
  from
    transform translateX(100%)
  to
    transform translateX(0)

@keyframes slideOutToRight
  from
    transform translateX(0)
  to
    transform translateX(100%)

@keyframes slideInFromLeft
  from
    transform translateX(-100%)
  to
    transform translateX(0)

@keyframes slideOutToLeft
  from
    transform translateX(0)
  to
    transform translateX(-100%)

@keyframes slideInFromTop
  from
    transform translateY(-100%)
  to
    transform translateY(0)

@keyframes slideOutToTop
  from
    transform translateY(0)
  to
    transform translateY(-100%)

@keyframes slideInFromBottom
  from
    transform translateY(100%)
  to
    transform translateY(0)

@keyframes slideOutToBottom
  from
    transform translateY(0)
  to
    transform translateY(100%)
