.root
  display flex
  align-items center
  gap 8px
  color var(--foreground)

.icon
  display block
  flex-shrink 0
  height 24px
  width auto
  color var(--brand-color-bg, var(--brand-color))

.text
  font-family var(--font-family-heading)
  line-height 48px

// Size variants
.sm
  .icon
    height 18px

  .text
    font-size var(--text-lg)
    line-height 36px

.md
  .icon
    height 24px

  .text
    font-size var(--text-2xl)
    line-height 48px

.lg
  .icon
    height 32px

  .text
    font-size var(--text-3xl)
    line-height 56px

