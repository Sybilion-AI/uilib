@import 'lib/theme.styl'

.toggle
  display inline-flex
  align-items center
  justify-content center
  gap 0.5rem
  white-space nowrap
  cursor pointer

  font-size var(--text-sm) //0.875rem
  font-weight 600
  color var(--muted-foreground)

  background-color transparent

  &:hover
    background-color var(--muted-80)
    color var(--muted-foreground)

  &:disabled
    pointer-events none
    opacity 0.5

  &[data-state='on']
    background-color var(--background)
    color var(--foreground)
    box-shadow 0 1px 2px 0 rgba(0, 0, 0, 0.05)

  svg
    pointer-events none
    flex-shrink 0

    &:not([class*='size-'])
      width 1rem
      height 1rem

  focus-outline()

  transition all 0.15s ease-in-out

  &[aria-invalid='true']
    border-color var(--destructive)
    box-shadow 0 0 0 3px var(--destructive-20)

    :global(.dark) &
      box-shadow 0 0 0 3px var(--destructive-40)

.variant-default
  border-radius 0.375rem

.variant-outline
  border none
  background-color transparent

  &:hover
    color var(--foreground)

  &[data-state='on']
    background-color var(--background)
    color var(--foreground)

.size-sm
  height 1.75rem
  padding-left 0.75rem
  padding-right 0.75rem
  border-radius 0.375rem

.size-md
  height 1.75rem
  padding-left 0.75rem
  padding-right 0.75rem
  border-radius 0.375rem

.size-lg
  height 2rem
  padding-left 0.875rem
  padding-right 0.875rem
  border-radius 0.5rem
