.container
  position relative
  display inline-block
  width 100%
  height 100%
  background-color var(--muted-50)

.image
  display block
  width 100%
  height 100%
  object-fit cover
  border-radius inherit

  &.loading
    opacity 0

.fallback
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  display flex
  align-items center
  justify-content center
  border-radius inherit

