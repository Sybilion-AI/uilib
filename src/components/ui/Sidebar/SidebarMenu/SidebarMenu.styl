@import '../../../../lib/theme.styl';

.sidebarMenu
  display flex
  flex-direction column
  gap var(--p-4)
  width 100%
  min-width 0
  padding 0 var(--p-11) var(--p-10) var(--p-8)
  list-style none

  @media (max-width unit(MOBILE, 'px'))
    padding-right var(--p-8)

.sidebarMenuItem
  position relative
  cursor pointer

.sidebarMenuBadge
  color var(--sidebar-foreground)
  pointer-events none
  position absolute
  right 0.25rem
  display flex
  height 1.25rem
  min-width 1.25rem
  align-items center
  justify-content center
  border-radius 0.375rem
  padding-left 0.25rem
  padding-right 0.25rem
  font-weight 500
  user-select none
  &[data-size="sm"]
    top 0.25rem
  &[data-size="md"]
    top 0.375rem
  &[data-size="lg"]
    top 0.625rem
  &[data-collapsible="icon"]
    display none

.sidebarMenuSkeleton
  display flex
  height 2rem
  align-items center
  gap 0.5rem
  border-radius 0.375rem
  padding-left 0.5rem
  padding-right 0.5rem

.sidebarMenuSkeletonIcon
  width 1rem
  height 1rem
  border-radius 0.375rem

.sidebarMenuSkeletonText
  height 1rem
  flex 1
  max-width var(--skeleton-width)
