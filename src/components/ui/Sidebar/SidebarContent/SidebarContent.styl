@import '../../../../lib/theme.styl';

.sidebarContent
  position absolute
  display flex
  flex 1
  flex-direction column
  gap var(--p-16)
  overflow auto

  width 100%
  height 100vh
  min-height 0
  max-height 100%

  @media (min-width MOBILE)
    height calc(100vh - var(--gap-top) - var(--app-banner-height, 0px))

  &[data-collapsible="icon"]
    overflow hidden

  [data-sheet-sidebar-inner] &
    position relative
    flex 1
    min-height 0
    height auto
    max-height none
