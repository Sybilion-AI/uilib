@import '../../../../lib/theme.styl';

.sidebarMenuSub
  position relative
  display flex
  flex-direction column
  gap var(--p-1)

  min-width 0
  padding 0
  padding-top var(--p-1)
  margin-left 0
  margin-right 0
  list-style none

  border-color var(--sidebar-border)
  transform translateX(1px)
  border-left none

  &::before
    content ''
    position absolute
    left var(--p-5)
    top 0
    bottom 0
    width 1px
    background var(--sidebar-border)
    pointer-events none

  &[data-collapsible="icon"]
    display none

.sidebarMenuSubItem
  position relative
  min-width 0
  margin-left var(--p-4)

  a:hover
    text-decoration: none;
