@import '../../../../lib/theme.styl';

.sidebarGroupLabel
  display flex
  align-items center
  width 100%
  min-width 0
  min-height 40px
  flex-shrink 0
  padding var(--p-2) var(--p-8)
  font-size var(--font-size-xs)
  text-transform uppercase
  font-weight 500
  line-height 1
  color var(--muted-foreground)
  pointer-events none
  user-select none
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
