@import '../../../lib/theme.styl';

// Legacy hooks (no dedicated component yet)
.sidebarInput
  background-color var(--background)
  height 2rem
  width 100%
  box-shadow none

.sidebarHeader
  display flex
  flex-direction column
  gap 0
  padding 0

// Sidebar main container (desktop aside)
.sidebar
  position fixed
  height 0
  --top-offset: -10px
  --gap-top: calc(var(--header-height) + var(--top-offset))
  top calc(var(--gap-top) + var(--app-banner-height, 0px))
  align-self flex-start
  display none
  flex-direction column

  width var(--sidebar-width)

  color var(--sidebar-foreground)
  // transition width 200ms ease-in-out

  @media (min-width MOBILE)
    &[data-state="expanded"]
      display flex
      height calc(100vh - var(--gap-top) - var(--app-banner-height, 0px))
      min-height 0

  &[data-collapsible="offcanvas"]
    width 0
    padding 0
    overflow hidden

// Variant styles
.variant-floating
  padding 0.5rem
  &[data-collapsible="icon"]
    width calc(var(--sidebar-width-icon) + 1rem + 2px)

.variant-inset
  &[data-collapsible="icon"]
    width calc(var(--sidebar-width-icon) + 1rem + 2px)

.variant-sidebar
  &[data-collapsible="icon"]
    width var(--sidebar-width-icon)
  &[data-side="left"]
    border-right 1px solid #e5e7eb
  &[data-side="right"]
    border-left 1px solid #e5e7eb

// Sheet content sidebar (mobile)
.sheetContentSidebar
  color var(--sidebar-foreground)
  width var(--sidebar-width)
  padding 0
  & > button
    display none

  @media (max-width: MOBILE)
    z-index 100

.sheetSidebarLogo
  position relative
  flex-shrink 0
  padding var(--p-6) var(--p-8) var(--p-2)

.sheetSidebarInner
  display flex
  height 100%
  width 100%
  flex-direction column
  background-color var(--sidebar)

// Sidebar none (non-collapsible)
.sidebarNone
  color var(--sidebar-foreground)
  display flex
  height 100%
  width var(--sidebar-width)
  flex-direction column

// View Transition API: opacity cross-fade is the UA default on old/new pseudos.
@keyframes sidebarVtOld
  from
    opacity 1
  to
    opacity 0

@keyframes sidebarVtNew
  from
    opacity 0
  to
    opacity 1

:global(::view-transition-old(sidebar-gap)),
:global(::view-transition-old(sidebar-container))
  animation-name sidebarVtOld
  animation-duration 200ms
  animation-timing-function ease-out
  transform translateZ(0)

:global(::view-transition-new(sidebar-gap)),
:global(::view-transition-new(sidebar-container))
  animation-name sidebarVtNew
  animation-duration 200ms
  animation-timing-function ease-out
  transform translateZ(0)
