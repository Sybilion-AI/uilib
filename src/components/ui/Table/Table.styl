.tableContainer
  position relative
  width 100%
  overflow-x auto

.scrollContainer
  width 100%

.scrollInner
  display block

.scrollbar
  bottom -6px

.withBackground
  padding 0 var(--p-6)
  background-color var(--background)
  border-radius var(--p-4)

.table
  width 100%
  caption-side bottom
  font-size var(--text-sm)
  overflow hidden

  &[data-size="sm"]
    font-size var(--text-xs)

    .tableHead
    .tableCell
      padding var(--p-2) var(--p-3)
      height auto

  &[data-size="md"]
    font-size var(--text-sm)

    .tableHead
    .tableCell
      padding var(--p-4) var(--p-3)
      height 65px

  &[data-size="lg"]
    font-size var(--text-base)

    .tableHead
    .tableCell
      padding var(--p-5) var(--p-4)
      height auto

  &.withPaddings
    .tableHead:first-child
    .tableCell:first-child
      padding-left var(--p-6)
    .tableHead:last-child
    .tableCell:last-child
      padding-right var(--p-6)

  .tableCell.compact
    height auto
    padding-top 0
    padding-bottom 0

.tableBody
  position relative

  &:not(:first-child)::before
    content ''
    display block
    height 1px
    position absolute
    left 0
    right 0
    background-color var(--border)

    .withBackground &
      left var(--p-6)
      right var(--p-6)

  tr:last-child
    border-bottom 0

.tableFooter
  background-color var(--muted-50)
  font-weight 500

  // .withBackground &
  //   border-top 1px solid var(--border)

  tr:last-child
    border-bottom 0

.tableRow
  position relative
  border-bottom 1px solid var(--border)
  transition-property background-color, color, border-color, text-decoration-color, fill, stroke
  transition-timing-function cubic-bezier(0.4, 0, 0.2, 1)
  transition-duration 150ms

  .tableBody:last-child &:last-child
    .tableCell:first-child
      border-bottom-left-radius var(--p-3)
    .tableCell:last-child
      border-bottom-right-radius var(--p-3)

  .tableBody &:hover
  &[data-state="selected"]
    background-color var(--muted-50)

.tableHead
  min-width 0
  color var(--muted-foreground)
  white-space nowrap
  text-align left
  vertical-align middle
  font-weight 500

  &:has([role="checkbox"])
    padding-right 0

  [role="checkbox"]
    transform translateY(2px)

.tableHead
.tableCell
  position relative
  z-index 1
  vertical-align middle
  white-space nowrap
  min-width 0

  &:has([role="checkbox"])
    padding-right 0

  [role="checkbox"]
    transform translateY(2px)

.cellValue
  display flex
  align-items center
  gap var(--p-1)

  color var(--muted-foreground)
