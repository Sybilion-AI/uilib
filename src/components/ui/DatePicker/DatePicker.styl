@import '../../../lib/theme.styl'

.inputRoot
  position relative
  display flex
  align-items stretch
  width 100%

.inputField
  padding-right 2.5rem

.calendarTrigger
  position absolute
  top 50%
  right 0.25rem
  transform translateY(-50%)
  color var(--muted-foreground)

  &:hover
    color var(--foreground)

.popupContent
  min-width 17.5rem
  padding var(--p-2)

.popupContent-sm
  width fit-content
  min-width auto

.picker
  display flex
  flex-direction column
  gap var(--p-2)

.pickerHeader
  display flex
  align-items center
  justify-content space-between
  gap var(--p-1)
  width 100%

.pickerMonthLabel
  flex 1
  text-align center
  font-size var(--text-sm)
  font-weight 600
  color var(--foreground)

.calendar
  display flex
  flex-direction column
  gap var(--p-1)

.weekdayRow
  display grid
  grid-template-columns repeat(7, 1fr)
  gap 0

.weekdayCell
  display flex
  align-items center
  justify-content center
  height 2rem
  font-size var(--text-xs)
  font-weight 500
  color var(--muted-foreground)

.dayGrid
  display grid
  grid-template-columns repeat(7, 1fr)
  gap 0

.dayCell
  display flex
  align-items center
  justify-content center
  border none
  background-color transparent
  color var(--foreground)
  cursor pointer
  transition background-color 150ms, color 150ms

  &:hover:not(:disabled)
    background-color var(--accent)
    color var(--accent-foreground)

  &:focus-visible
    outline 2px solid var(--ring)
    outline-offset 1px

  &:disabled
    cursor not-allowed
    opacity 0.35

.dayOutsideMonth
  color var(--muted-foreground)

.daySelected
  background-color var(--primary)
  color var(--primary-foreground)

  &:hover:not(:disabled)
    background-color var(--primary)
    color var(--primary-foreground)

.dayToday:not(.daySelected):not(.dayRangeStart):not(.dayRangeEnd)
  box-shadow inset 0 0 0 1px var(--ring)

.dayInRange
  background-color var(--accent)
  color var(--accent-foreground)
  border-radius 0

  &:hover:not(:disabled)
    background-color var(--accent)
    color var(--accent-foreground)

.dayInRangePreview
  background-color unquote('color-mix(in srgb, var(--accent) 70%, transparent)')

.dayRangeStart
  background-color var(--primary)
  color var(--primary-foreground)
  border-top-right-radius 0
  border-bottom-right-radius 0

  &:hover:not(:disabled)
    background-color var(--primary)
    color var(--primary-foreground)

.dayRangeEnd
  background-color var(--primary)
  color var(--primary-foreground)
  border-top-left-radius 0
  border-bottom-left-radius 0

  &:hover:not(:disabled)
    background-color var(--primary)
    color var(--primary-foreground)

.dayRangeStart.dayRangeEnd
  border-radius var(--radius-input)

.rangeInputRoot
  position relative
  display flex
  align-items stretch
  width 100%

.rangeInputField
  flex 1
  min-width 0

.rangeInputFieldActive
  box-shadow inset 0 0 0 2px var(--brand-color-400) !important

.rangeSeparator
  display flex
  align-items center
  padding 0 var(--p-1)
  color var(--muted-foreground)
  user-select none

.rangeCalendarTrigger
  position absolute
  top 50%
  right 0.25rem
  transform translateY(-50%)
  color var(--muted-foreground)

  &:hover
    color var(--foreground)

.rangeInputRoot .rangeInputField:last-of-type
  padding-right 2.5rem

.inputSize-sm
.pickerSize-sm
.calendarSize-sm
  .dayCell
    width var(--p-6)
    height var(--p-6)
    font-size var(--text-xs)

.pickerSize-sm
  align-items center

.calendarSize-sm
  width fit-content

  .weekdayRow
  .dayGrid
    width fit-content
    grid-template-columns repeat(7, var(--p-6))

.inputSize-md
.calendarSize-md
  .dayCell
    width var(--p-10)
    height var(--p-10)
    font-size var(--text-sm)

.pickerSize-lg
.calendarSize-lg
  .dayCell
    width var(--p-10)
    height var(--p-10)
    font-size var(--text-base)

.srOnly
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0
