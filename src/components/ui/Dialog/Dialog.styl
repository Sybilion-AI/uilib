@import 'lib/theme.styl'

// Dialog overlay styles
.dialogOverlay
  position fixed
  inset 0
  z-index 50
  background-color var(--background-alpha-700)
  backdrop-filter blur(4px)
  opacity 0
  transition opacity 200ms ease-out

  &.isOpen
    opacity 1
    animation-name fadeIn
    animation-duration 200ms
    animation-timing-function ease-out
    animation-fill-mode forwards

// Dialog content base styles
.dialogContent
  position fixed
  left 50%
  top 50%
  z-index 50
  display flex

  width fit-content
  max-height calc(100% - var(--p-4))

  transform translateX(-50%) translateY(-50%)
  border-radius 20px
  box-shadow 0 0 0 1px var(--border), 0 10px 15px -3px var(--border), 0 4px 6px -2px var(--border)
  transition all 200ms ease-out

  :global(.dark) &
    box-shadow 0 0 0 1px var(--border), 0 10px 15px -3px oklch(0 0 0 / 1), 0 4px 6px -2px oklch(0 0 0 / 0.5)

  opacity 0
  transform translateX(-50%) translateY(-50%) scale(0.95)

  &.isOpen
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)
    animation-name dialogIn
    animation-duration 200ms
    animation-timing-function ease-out
    animation-fill-mode forwards

  &.isClosed
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)
    animation-name dialogOut
    animation-duration 200ms
    animation-timing-function ease-in
    animation-fill-mode forwards
    pointer-events none

  // Mobile default: 80% width
  @media (max-width: unit(MOBILE, 'px'))
    width calc(100% - var(--p-4))
    max-width @width

// Wide size variant
.size-wide
  max-width calc(100% - var(--p-4))
  @media (min-width: unit(MOBILE, 'px'))
    max-width 80rem
  // @media (max-width: unit(MOBILE, 'px'))
  //   width 90vw
  //   max-width 90vw

// Dialog description styles
.dialogDescription
  font-size 0.875rem
  color var(--muted-foreground)

// Dialog close button styles
.dialogClose
  position absolute
  right var(--p-2)
  top var(--p-2)
  z-index 10
  display flex
  align-items center
  justify-content center
  height 2rem
  width 2rem
  border-radius 0.125rem
  opacity 0.7
  outline none
  transition opacity 200ms ease, transform 200ms ease
  transform-origin center
  cursor pointer
  background-color transparent
  border none
  &:hover
    opacity 1
    transform scale(1.1)
  &:focus-visible
    box-shadow 0 0 0 2px var(--ring)
  &:disabled
    pointer-events none

// Animations
@keyframes fadeIn
  from
    opacity 0
  to
    opacity 1

@keyframes fadeOut
  from
    opacity 1
  to
    opacity 0

@keyframes dialogIn
  from
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)
  to
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)

@keyframes dialogOut
  from
    opacity 1
    transform translateX(-50%) translateY(-50%) scale(1)
  to
    opacity 0
    transform translateX(-50%) translateY(-50%) scale(0.95)

// Footer alignment (overrides Card .footer justify-content)
.dialogContent [data-slot="card-footer"]
  &.align-left
    justify-content flex-start
  &.align-center
    justify-content center
  &.align-right
    justify-content flex-end
  &.align-between
    justify-content space-between
