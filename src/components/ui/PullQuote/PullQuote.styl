.root
  border-left 2px solid var(--sb-cyan-400)
  padding 6px 0 6px 20px

.body
  font-family var(--font-family-heading)
  font-size var(--text-2xl)
  line-height 1.25
  font-weight 400
  letter-spacing var(--tracking-heading)
  color var(--sb-slate-800)
  text-wrap pretty

  :global(.dark) &
    color var(--sb-slate-200)

// Small text — Manrope, sentence case, zero tracking
.attribution
  margin-top var(--p-4)
  font-family var(--font-family-body)
  font-size var(--text-xs)
  font-weight 500
  letter-spacing var(--tracking-body)
  color var(--sb-slate-800)

  :global(.dark) &
    color var(--sb-slate-300)

.role
  margin-left 6px
  font-weight 400
  color var(--sb-slate-500)
