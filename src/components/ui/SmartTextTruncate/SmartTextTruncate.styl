.root
  position relative
  overflow hidden
  min-width 0

// Middle-truncated label — visible when settled.
.measuredLabel
  display block
  white-space nowrap
  overflow hidden
  min-width 0

// Full text + end ellipsis — visible only while dragging/resizing (html flag).
.liveLabel
  display none
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  min-width 0

:global(html[data-smart-text-truncate-fast]) .measuredLabel
  display none

:global(html[data-smart-text-truncate-fast]) .liveLabel
  display block

:global(html[data-smart-text-truncate-fast]) .fullText
  display none

.fullText
  position absolute
  visibility hidden
  white-space nowrap
  top -9999px
