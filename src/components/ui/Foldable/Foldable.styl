@import 'lib/theme.styl'

.root
  display flex
  flex-direction column
  border 1px solid var(--border)
  border-radius var(--p-3)
  background-color var(--background)
  overflow hidden

  & + &
    margin-top var(--p-1)

.header
  display flex
  justify-content space-between
  align-items center
  padding var(--p-2)
  cursor pointer
  user-select none
  transition background-color 0.2s ease

  .unfolded &
  &:hover
    background-color var(--page-color-alpha-800)

.headerContent
  flex 1
  display flex
  align-items center

.toggle
  display flex
  align-items center
  margin-left var(--p-2)

.icon
  color var(--text-color-secondary)
  transition transform 0.2s ease

.content
  padding 0 var(--p-4) var(--p-4) var(--p-4)
  display flex
  flex-direction column
  gap var(--p-3)

  .unfolded &
    background-color var(--page-color-alpha-800)
