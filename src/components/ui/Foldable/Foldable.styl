@import 'lib/theme.styl'

.root
  display flex
  flex-direction column
  border 1px solid var(--border)
  border-radius var(--p-3)
  background-color var(--background)
  overflow hidden

  & + &
    margin-top var(--p-1)

.header
  display flex
  justify-content space-between
  align-items center
  padding var(--p-2)
  cursor pointer
  user-select none
  transition background-color 0.2s ease

  .unfolded &
  &:hover
    background-color var(--page-color-alpha-800)

.headerContent
  flex 1
  display flex
  align-items center

.toggle
  display flex
  align-items center
  margin-left var(--p-2)
  opacity 0.3
  transition 0.1s ease-out

  .root:hover &
    opacity 1

.icon
  color var(--text-color-secondary)
  transition transform 0.1s ease

  .unfolded &
    transform rotate(180deg)

.content
  padding 0 var(--p-2) var(--p-2) var(--p-2)
  display flex
  flex-direction column
  gap var(--p-3)

  .unfolded &
    background-color var(--page-color-alpha-800)

.content.contentHidden
.root.clear .content.contentHidden
  display none

// No card chrome: used inside surfaces that already have a panel (e.g. a drawer).
.root.clear
  border none
  border-radius 0
  background-color transparent
  overflow visible

  & + &
    margin-top 0

  .header
    padding 0
    background-color transparent

    &:hover
      background-color transparent

  &.unfolded .header
    background-color transparent

  .content
    padding 8px 0 0
    background-color transparent

  &.unfolded .content
    background-color transparent
