.root
  width 100%

.legend
  flex-wrap wrap
  row-gap 0.5rem
  margin-top 0.75rem

.legendButton
  appearance none
  background none
  border 0
  padding 0
  font inherit
  color inherit
  cursor pointer

.dimmed
  opacity 0.4

.legendExtra
  color var(--muted-foreground)
  font-variant-numeric tabular-nums

.legendLine
  width 14px
  height 2px
  flex-shrink 0
  border-radius 1px

.legendZone
  border 1px solid var(--border)
