.root
  border-radius 0.375rem
  background-color var(--accent-color-alpha-100)
  animation pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite

  @keyframes pulse
    0%, 100%
      opacity 1
    50%
      opacity 0.5

// Size variants
.size-sm
  height 1rem

.size-md
  height 1.5rem

.size-lg
  height 2.5rem

// Shape variants
.shape-rectangle
  border-radius 0.375rem

.shape-circle
  border-radius 9999px

.shape-rounded
  border-radius 0.5rem

