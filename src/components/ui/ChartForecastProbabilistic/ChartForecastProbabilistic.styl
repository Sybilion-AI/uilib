.root
  position: relative
  width: 100%

.chartContainer
  width: 100%
  transition: opacity 0.3s ease
  
  &.loading
    opacity: 0.6
    pointer-events: none

.loadingOverlay
  position: absolute
  top: 0
  left: 0
  right: 0
  bottom: 0
  display: flex
  align-items: center
  justify-content: center
  background: rgba(255, 255, 255, 0.8)
  z-index: 10
  border-radius: 8px
  
  .dark &
    background: rgba(0, 0, 0, 0.5)

.loadingSpinner
  width: 40px
  height: 40px
  border: 3px solid #e5e7eb
  border-top-color: #3b82f6
  border-radius: 50%
  animation: spin 0.6s linear infinite
  
  .dark &
    border-color: #374151
    border-top-color: #60a5fa

.errorContainer
  display: flex
  align-items: center
  justify-content: center
  height: 300px
  color: #6b7280
  font-size: 14px
  
  .dark &
    color: #9ca3af

@keyframes spin
  from
    transform: rotate(0deg)
  to
    transform: rotate(360deg)

