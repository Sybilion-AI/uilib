@import 'lib/theme.styl'

.root
  display flex
  flex-direction column
  gap var(--p-2)

.rootContained
  position relative
  width 100%
  height 100%

.rootDragging
  pointer-events auto

.dropArea
  position relative
  border 2px dashed var(--border)
  border-radius var(--p-4)
  padding var(--p-4)
  text-align center
  cursor pointer
  transition all 0.2s ease
  background-color var(--page-color)

  & label::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    border-radius var(--p-4)

  &:hover:not(.disabled)
    border-color var(--primary-color)
    background-color var(--page-color-alpha-800)

  &.isDragging
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index 9999
    display flex
    align-items center
    justify-content center

    border-color var(--primary-color)
    background-color var(--page-color-alpha-800)

  &.isDraggingContained
    position absolute
    top 0
    left 0
    width 100%
    height 100%
    z-index 1
    display flex
    align-items center
    justify-content center
    border-radius var(--p-4)

    border-color var(--primary-color)
    background-color var(--page-color-alpha-800)

  &:hover:not(.disabled)
  &.isDragging
  &.isDraggingContained
    border 2px dashed var(--muted-border)

    :global(.dark) &
      background-color var(--background)

  &.disabled
    opacity 0.6
    cursor not-allowed

.fileInput
  display none

.label
  cursor pointer
  color var(--text-color-secondary)

.error
  color var(--error-color)
  font-size 0.875rem
  padding var(--p-1) var(--p-2)
