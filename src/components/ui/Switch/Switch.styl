.switchRoot
  position relative
  display inline-flex
  padding 3px
  flex-shrink 0
  cursor pointer
  border-radius 9999px
  border none
  background-color var(--input)
  transition background-color 0.15s ease-in-out
  outline none

  &[data-state=checked]
    background-color var(--primary)

  &:focus-visible
    outline 2px solid var(--primary)
    outline-offset 2px

  &:disabled
    cursor not-allowed
    opacity 0.5

.switchThumb
  display block
  border-radius 9999px
  background-color var(--card)
  box-shadow 0px 10px 15px -3px rgba(0, 0, 0, 0.1), 0px 4px 6px -4px rgba(16, 24, 40, 0.1)
  transition transform 0.15s ease-in-out
  will-change transform

.size-sm
  width 36px
  height 20px

  .switchThumb
    width 14px
    height 14px

  &[data-state=checked] .switchThumb
    transform translateX(16px)

.size-md
  width 44px
  height 24px

  .switchThumb
    width 18px
    height 18px

  &[data-state=checked] .switchThumb
    transform translateX(20px)

.size-lg
  width 52px
  height 28px

  .switchThumb
    width 22px
    height 22px

  &[data-state=checked] .switchThumb
    transform translateX(24px)
