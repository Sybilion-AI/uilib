{
  "name": "@sybilion/uilib",
  "version": "1.4.39",
  "description": "Sybilion Design System — React UI components (Webpack + Stylus)",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/esm/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/esm/types/index.d.ts",
  "sideEffects": [
    "**/*.styl",
    "**/*.css",
    "**/*.styl.js"
  ],
  "imports": {
    "#uilib/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "default": "./dist/esm/src/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./dist/esm/types/src/hooks/index.d.ts",
      "import": "./dist/esm/src/hooks/index.js",
      "default": "./dist/esm/src/hooks/index.js"
    },
    "./src/*": "./src/*",
    "./logo.svg": "./src/components/ui/Logo/logo.svg"
  },
  "files": [
    "assets",
    "docs",
    "src",
    "dist",
    "dist/agent-glossary",
    "package.json"
  ],
  "directories": {
    "dist": "./dist"
  },
  "scripts": {
    "tests": "jest",
    "tests:watch": "jest --watch",
    "ts": "tsc --noEmit",
    "dev": "NODE_OPTIONS='--loader ts-node/esm' NODE_ENV=development webpack-dev-server --mode=development --config ./src/docs/config/webpack.config.js --progress",
    "prebuild": "cp src/components/ui/Logo/logo.svg assets/logo.svg",
    "build:agent-glossary": "node scripts/build-agent-glossary.mjs --all",
    "build": "yarn build:agent-glossary && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "build:watch": "yarn build --watch",
    "build:compress": "COMPRESS=true yarn build",
    "publish:npm": "yarn build && npm publish --access public",
    "docs:build": "NODE_OPTIONS='--loader ts-node/esm' NODE_ENV=production webpack --mode=production --config ./src/docs/config/webpack.config.js --progress",
    "release": "standard-version",
    "release:major": "yarn release -- --release-as major",
    "release:minor": "yarn release -- --release-as minor",
    "release:patch": "yarn release -- --release-as patch",
    "release:as": "yarn release -- --release-as"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Mir-Insight/uilib.git"
  },
  "keywords": [
    "ui",
    "library",
    "design",
    "system",
    "react"
  ],
  "author": "apostololeg",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mir-Insight/uilib/issues"
  },
  "homepage": "https://github.com/Mir-Insight/uilib#readme",
  "dependencies": {
    "@homecode/ui": "^5.3.11",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
